<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Filled from Config/App.xcconfig at build time. See docs/ci-cd.md. -->
	<key>AppEnvironment</key>
	<string>$(APP_ENVIRONMENT)</string>
	<key>APIHost</key>
	<string>$(API_HOST)</string>
	<!-- Bundled fonts in Resources/Fonts. They are copied to the bundle root. -->
	<key>UIAppFonts</key>
	<array>
		<string>BarlowCondensed-Medium.ttf</string>
		<string>BarlowCondensed-SemiBold.ttf</string>
	</array>
</dict>
</plist>
